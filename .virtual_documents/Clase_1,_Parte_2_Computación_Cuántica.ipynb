    [np.sqrt(3)/2, -1/2 * (np.exp(-1j * np.pi/7))],
    [1/2 * (np.exp(1j * np.pi / 5)), np.sqrt(3)/2 * (np.exp(1j * ((np.pi / 5) - (np.pi / 7))))],
