# Escribe tu código aquí

# Creo el circuito cuántico de un qubit
qc = QuantumCircuit(1)

# Aplico una única compuerta RY(theta) con theta = 3pi / 4
theta = 2 * np.pi / 4
qc.ry(theta, 0)

# Despues obtenemos ek vectir de estado resultante
estado = Statevector.from_instruction(qc)

# Imprimimos las probabilidades de medir |0> y |1>
probs = estado.probabilities_dict()
print(f"Probabilidad de medir |0⟩: {probs['0'] * 100:.1f}%")
print(f"Probabilidad de medir |1⟩: {probs['1'] * 100:.1f}%")

# Por último mostramos la representación pero en la esfera de Bloch
plot_bloch_multivector(estado)










