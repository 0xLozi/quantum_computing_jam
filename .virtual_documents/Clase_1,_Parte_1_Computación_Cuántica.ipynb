import numpy as np

#Escriba su código aquí para la parte c
def crear_superposicion_equiprobable(n):
  N = 2**n # Para los estados
  amplitudes = [1 / np.sqrt(N)] * N
  return Statevector(amplitudes)

print("Ahora vamos a crear un sistema de 3 qubits que posee 8 estados posibles")
qubit = crear_superposicion_equiprobable(3)
print(qubit)









